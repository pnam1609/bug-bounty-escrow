# Workspace environment template.
# Copy the relevant section into apps/web/.env.local or apps/api/.env.
# Values using "replace-with-..." or reserved .invalid domains are placeholders.

# Web — every browser-visible variable must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-supabase-anon-key
NEXT_PUBLIC_ARC_RPC_URL=https://arc-rpc.example.invalid
NEXT_PUBLIC_ARC_EXPLORER_URL=https://arc-explorer.example.invalid
NEXT_PUBLIC_ARC_CHAIN_ID=replace-with-arc-chain-id
NEXT_PUBLIC_USDC_ADDRESS=replace-with-usdc-contract-address

# API — never copy service-role or AI credentials into the web environment.
NODE_ENV=development
PORT=3001
WEB_APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://supabase.example.invalid
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ARC_RPC_URL=https://arc-server-rpc.example.invalid
ARC_CHAIN_ID=replace-with-arc-chain-id
USDC_ADDRESS=replace-with-usdc-contract-address
# Optional until an escrow factory is deployed:
# ESCROW_FACTORY_ADDRESS=replace-with-escrow-factory-address
AI_PROVIDER=mock
# Required only when AI_PROVIDER=gemini:
# GEMINI_API_KEY=replace-with-gemini-api-key
LOG_LEVEL=info
