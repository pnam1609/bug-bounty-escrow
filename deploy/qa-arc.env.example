# QA-ARC-01 live Arc Testnet acceptance template.
#
# Copy this file to `.tmp/qa-arc.env`, replace every placeholder locally, and
# never commit the populated copy. The runner reads credentials only from the
# process environment and never accepts them as command-line arguments.

# Short-lived access token for the dedicated non-demo owner account.
QA_ARC_ACCESS_TOKEN=replace-with-short-lived-owner-access-token
QA_ARC_EXPECTED_OWNER_ID=00000000-0000-4000-8000-000000000000

# Exact trusted public origins. HTTPS only; no path, query, fragment, credentials,
# localhost, private address, or IP literal.
QA_ARC_EXPECTED_API_ORIGIN=https://bountyescrow.xyz
QA_ARC_EXPECTED_WEB_ORIGIN=https://bountyescrow.xyz

# Read-only JSON-RPC endpoints used to independently verify chain IDs, contracts,
# committed receipts, logs, and block hashes.
ARC_RPC_URL=https://replace-with-arc-testnet-rpc.example.invalid
ETHEREUM_SEPOLIA_RPC_URL=https://replace-with-ethereum-sepolia-rpc.example.invalid
ARBITRUM_SEPOLIA_RPC_URL=https://replace-with-arbitrum-sepolia-rpc.example.invalid
BASE_SEPOLIA_RPC_URL=https://replace-with-base-sepolia-rpc.example.invalid

# Locally pinned escrow artifact. Resolve relative paths from the repository root.
BOUNTY_ESCROW_ARTIFACT_PATH=packages/contracts/artifacts/BountyEscrow.v1.json

# Circle values are used only for read-only wallet/subscription preflight.
CIRCLE_API_KEY=replace-with-circle-api-key
CIRCLE_DEPLOYMENT_WALLET_ID=00000000-0000-4000-8000-000000000000

# Must contain exactly one TEST subscription UUID. This intentionally matches
# the production runtime variable name and rejects empty or comma-separated lists.
CIRCLE_GATEWAY_WEBHOOK_SUBSCRIPTION_IDS=00000000-0000-4000-8000-000000000000
