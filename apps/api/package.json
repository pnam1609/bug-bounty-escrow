{
  "name": "@bug-bounty-escrow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cleanup:attachments": "tsx scripts/cleanup-attachments.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "openapi:check": "tsx scripts/openapi.ts check",
    "openapi:generate": "tsx scripts/openapi.ts generate",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bug-bounty-escrow/domain": "workspace:*",
    "@bug-bounty-escrow/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@supabase/supabase-js": "^2.110.8",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "^7.2.1",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
