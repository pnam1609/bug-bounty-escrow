server {
    listen 80;
    listen [::]:80;
    server_name supabase.bountyescrow.xyz;

    client_max_body_size 50m;

    access_log /var/log/nginx/supabase.bountyescrow.xyz.access.log;
    error_log /var/log/nginx/supabase.bountyescrow.xyz.error.log;

    location ~ ^/(auth|rest|storage|realtime|functions|graphql)/v1/ {
        proxy_pass http://127.0.0.1:7832;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Supabase Studio and internal administration endpoints are intentionally
    # not exposed on this public hostname.
    location / {
        return 404;
    }
}
