# Copy this file to /opt/bounty-escrow/public-build.env on the VPS.
# These values are embedded in the browser bundle and are not secrets.

NEXT_PUBLIC_API_BASE_URL=https://bountyescrow.xyz
NEXT_PUBLIC_SUPABASE_URL=https://supabase.bountyescrow.xyz
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-supabase-anon-key
NEXT_PUBLIC_ARC_RPC_URL=https://arc-rpc.example.invalid
NEXT_PUBLIC_ARC_EXPLORER_URL=https://arc-explorer.example.invalid
NEXT_PUBLIC_ARC_CHAIN_ID=replace-with-arc-chain-id
NEXT_PUBLIC_USDC_ADDRESS=replace-with-usdc-contract-address
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
NEXT_PUBLIC_DEMO_MODE=false
