# Copy this file to /opt/bounty-escrow/.env.production on the VPS.
# Keep the real file readable only by the deploy user and never commit it.

WEB_APP_ORIGIN=https://bountyescrow.xyz

# Host ports are loopback-only and intentionally avoid common ports already used
# by other services on a shared VPS.
WEB_BIND_PORT=7830
API_BIND_PORT=7831

SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Temporary server-only hackathon waiver (2026-08-07 23:59 Asia/Saigon).
# Missing or expired values make the Nest API and future deploys deny the exact
# seven IDs; expiry does not revoke Supabase credentials, sessions, JWTs,
# Storage access, or signed URLs. Malformed nonblank values fail API startup.
# Remove this assignment after SEC cleanup and replacing the hackathon test data.
# LOCAL_DEMO_IDENTITIES_ALLOWED_UNTIL=2026-08-07T16:59:00Z

# Use the direct/session PostgreSQL connection string for migrations, not the REST API URL.
DATABASE_URL=postgresql://postgres:replace-with-password@supabase-db:5432/postgres

ARC_RPC_URL=https://arc-rpc.example.invalid
ARC_CHAIN_ID=replace-with-arc-chain-id
USDC_ADDRESS=replace-with-usdc-contract-address
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.example.invalid
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia-rpc.example.invalid
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.example.invalid

# CP-13 Circle Contracts custom escrow deployment (server-only).
# Follow the two-phase bootstrap in deploy/README.md. First deploy the new image
# with both Circle feature flags false so the public Gateway HEAD endpoint exists.
# Add real values only to /opt/bounty-escrow/.env.production; never commit them.
CIRCLE_CONTRACTS_ENABLED=false
# Required when CIRCLE_CONTRACTS_ENABLED=true:
# CIRCLE_API_KEY=replace-with-circle-api-key
# CIRCLE_ENTITY_SECRET=replace-with-64-character-circle-entity-secret
# CIRCLE_DEPLOYMENT_WALLET_ID=00000000-0000-4000-8000-000000000000
CIRCLE_API_BASE_URL=https://api.circle.com
CIRCLE_REQUEST_TIMEOUT_MS=15000
CIRCLE_POLL_INTERVAL_MS=2000
CIRCLE_POLL_TIMEOUT_MS=120000
BOUNTY_ESCROW_ARTIFACT_PATH=packages/contracts/artifacts/BountyEscrow.v1.json

# Unified Balance source deposits require signed Gateway finalization events.
# Create exactly one stable TEST permissionless subscription for the public HTTPS
# endpoint https://bountyescrow.xyz/api/webhooks/circle/gateway, restricted to
# gateway.deposit.finalized. During disabled bootstrap, CIRCLE_API_KEY must be
# configured: the API verifies Circle's signed creation test but does not persist
# its unknown subscription ID. Business notifications remain disabled.
#
# The desired address/domain filter is a bounded append-only union: at most 50
# owner addresses, domains 0/3/6/26, and no automatic garbage collection.
# Never add a second ID or manually remove a registered address.
CIRCLE_GATEWAY_WEBHOOKS_ENABLED=false
CIRCLE_GATEWAY_WEBHOOK_SUBSCRIPTION_IDS=
CIRCLE_GATEWAY_TESTNET_API_URL=https://gateway-api-testnet.circle.com

AI_PROVIDER=disabled
# GEMINI_API_KEY=replace-with-gemini-api-key

LOG_LEVEL=info
