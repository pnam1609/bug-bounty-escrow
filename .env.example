# Workspace environment template.
# Copy the relevant section into apps/web/.env.local or apps/api/.env.
# Values using "replace-with-..." or reserved .invalid domains are placeholders.

# Web — every browser-visible variable must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-supabase-anon-key
NEXT_PUBLIC_ARC_RPC_URL=https://arc-rpc.example.invalid
NEXT_PUBLIC_ARC_EXPLORER_URL=https://arc-explorer.example.invalid
NEXT_PUBLIC_ARC_CHAIN_ID=replace-with-arc-chain-id
NEXT_PUBLIC_USDC_ADDRESS=replace-with-usdc-contract-address

# API — never copy service-role or AI credentials into the web environment.
NODE_ENV=development
PORT=3001
WEB_APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://supabase.example.invalid
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ARC_RPC_URL=https://arc-server-rpc.example.invalid
ARC_CHAIN_ID=replace-with-arc-chain-id
USDC_ADDRESS=replace-with-usdc-contract-address
# Optional until an escrow factory is deployed:
# ESCROW_FACTORY_ADDRESS=replace-with-escrow-factory-address
# Canonical BountyEscrowAdmin controller (deploy this once). It collects the
# fixed per-program fee and is the support authority for program escrows. It
# must never be used as a program withdrawal recipient.
# BOUNTY_ESCROW_ADMIN_CONTRACT_ADDRESS=replace-with-bounty-escrow-admin-address
# PLATFORM_FEE_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
# PLATFORM_FEE_CHAIN_ID=5042002
# PLATFORM_FEE_AMOUNT_BASE_UNITS=1000000
# Set once and reuse if the admin-contract deploy needs recovery/retry.
# BOUNTY_ESCROW_ADMIN_DEPLOY_IDEMPOTENCY_KEY=replace-with-uuid
# CP-13 Circle Contracts custom escrow deployment (server-only, disabled by default).
CIRCLE_CONTRACTS_ENABLED=false
# Signed Gateway deposit-finalized webhooks (server-only). When enabled, configure
# exactly one pre-provisioned TEST permissionless subscription. The API keeps its
# address/domain filters exact and verifies them before a source transfer.
CIRCLE_GATEWAY_WEBHOOKS_ENABLED=false
CIRCLE_GATEWAY_WEBHOOK_SUBSCRIPTION_IDS=
# Required for Circle's disabled webhook bootstrap and Circle Contracts:
# CIRCLE_API_KEY=replace-with-circle-api-key
# Required only when CIRCLE_CONTRACTS_ENABLED=true:
# CIRCLE_ENTITY_SECRET=replace-with-64-character-circle-entity-secret
# CIRCLE_DEPLOYMENT_WALLET_ID=00000000-0000-4000-8000-000000000000
CIRCLE_API_BASE_URL=https://api.circle.com
CIRCLE_REQUEST_TIMEOUT_MS=15000
CIRCLE_POLL_INTERVAL_MS=2000
CIRCLE_POLL_TIMEOUT_MS=120000
BOUNTY_ESCROW_ARTIFACT_PATH=packages/contracts/artifacts/BountyEscrow.v1.json
AI_PROVIDER=mock
# Supported modes: mock, gemini, deepseek, disabled. Hosted providers are server-only.
# Required only when AI_PROVIDER=gemini:
# GEMINI_API_KEY=replace-with-gemini-api-key
# Required only when AI_PROVIDER=deepseek:
# DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# Optional model/base URL overrides; adapters use provider-safe defaults.
# AI_MODEL=gemini-3.5-flash
# AI_API_BASE_URL=https://generativelanguage.googleapis.com
# AI_PRIVACY_MODE=demo
# AI_REQUEST_TIMEOUT_MS=15000
# AI_MAX_RETRIES=2
LOG_LEVEL=info
