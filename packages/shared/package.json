{
  "name": "@bug-bounty-escrow/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "security:dependencies": "pnpm audit --prod --audit-level critical",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bug-bounty-escrow/domain": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
